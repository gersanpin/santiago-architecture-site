{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "santiago-architecture-site",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "santiago-architecture-site"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true,
      "destination_address": "gersantiago.arch@gmail.com",
      "allowed_sender_addresses": ["hello@santiago-architecture.com"]
    }
  ],
  "vars": {
    "CONTACT_TO_EMAIL": "gersantiago.arch@gmail.com",
    "CONTACT_FROM_EMAIL": "hello@santiago-architecture.com"
  }
}
